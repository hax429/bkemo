{
  "name": "bkemo-obsidian",
  "version": "0.1.0",
  "description": "Private bkemo companion plugin for Obsidian",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts"
  },
  "keywords": ["obsidian", "bkemo"],
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "obsidian": "latest",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
